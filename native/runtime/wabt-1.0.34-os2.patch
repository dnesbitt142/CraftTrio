+uint64_t wasm_rt_committed_memory_bytes(const wasm_rt_memory_t* memory) {
+  const uint64_t reclaimed = wasm_rt_reclaimed_memory_bytes(memory);
+  return memory && reclaimed <= memory->size ? memory->size - reclaimed : 0;
+}
