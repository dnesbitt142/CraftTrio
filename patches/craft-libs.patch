+    #[test]
+    fn custom_image_hash_does_not_clone_a_raster() {
+        use std::hash::{Hash, Hasher};
+        use std::sync::atomic::{AtomicUsize, Ordering};
+        static CLONES: AtomicUsize = AtomicUsize::new(0);
+        struct Samples(Vec<u8>);
+        impl Clone for Samples {
+            fn clone(&self) -> Self {
+                CLONES.fetch_add(1, Ordering::SeqCst);
+                Self(self.0.clone())
+            }
+        }
+        impl Hash for Samples {
+            fn hash<H: Hasher>(&self, state: &mut H) {
+                self.0.hash(state);
+            }
+        }
+        impl super::CustomImage for Samples {
+            fn color_channel(&self) -> &[u8] {
+                &self.0
+            }
+            fn alpha_channel(&self) -> Option<&[u8]> {
+                None
+            }
+            fn bits_per_component(&self) -> super::BitsPerComponent {
+                super::BitsPerComponent::Eight
+            }
+            fn size(&self) -> (u32, u32) {
+                (1, 1)
+            }
+            fn icc_profile(&self) -> Option<&[u8]> {
+                None
+            }
+            fn color_space(&self) -> super::ImageColorspace {
+                super::ImageColorspace::Rgb
+            }
+        }
+        use super::SipHashable;
+        let samples = Samples(vec![10, 20, 30]);
+        let expected = (samples.clone(), false).sip_hash();
+        CLONES.store(0, Ordering::SeqCst);
+        let image = Image::from_custom(samples, false).unwrap();
+        assert_eq!(CLONES.load(Ordering::SeqCst), 0);
+        assert_eq!(
+            image.0.sip, expected,
+            "content-cache identity must remain unchanged"
+        );
+    }
