+    #[test]
+    fn streamed_interleaved_channels_match_legacy_compression() {
+        for pixels in [0, 1, 17, 1023, 1024, 1025, 4099] {
+            for (colors, alpha_bytes) in [(3, 1), (1, 1), (6, 2), (2, 2)] {
+                for opaque in [false, true] {
+                    let pixel_bytes = colors + alpha_bytes;
+                    let mut data: Vec<u8> = (0..pixels * pixel_bytes)
+                        .map(|i| ((i * 73 + i / 7) % 251) as u8)
+                        .collect();
+                    if opaque {
+                        for pixel in data.chunks_exact_mut(pixel_bytes) {
+                            pixel[colors..].fill(255);
+                        }
+                    }
+                    let mut legacy_color = Vec::new();
+                    let mut legacy_alpha = Vec::new();
+                    for pixel in data.chunks_exact(pixel_bytes) {
+                        legacy_color.extend_from_slice(&pixel[..colors]);
+                        legacy_alpha.extend_from_slice(&pixel[colors..]);
+                    }
+                    let expected_alpha = (!legacy_alpha.is_empty()
+                        && legacy_alpha.iter().any(|a| *a != 255))
+                    .then(|| super::deflate_encode(&legacy_alpha));
+                    let (color, alpha) =
+                        super::stream_image_channels(&data, colors, alpha_bytes).unwrap();
+                    assert_eq!(
+                        color,
+                        super::deflate_encode(&legacy_color),
+                        "colors={colors} alpha={alpha_bytes} pixels={pixels}"
+                    );
+                    assert_eq!(
+                        alpha, expected_alpha,
+                        "alpha={alpha_bytes} pixels={pixels} opaque={opaque}"
+                    );
+                }
+            }
+        }
+    }
