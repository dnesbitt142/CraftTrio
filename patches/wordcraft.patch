@@ -0,0 +1,103 @@
+//! OS/2 browser and nonblocking local TCP adapters.
+use std::io::{self, Read, Write};
+
+use wordcraft_ui_egui::zotero;
+
+#[link(wasm_import_module = "wc_host")]
+unsafe extern "C" {
+    fn open_url_native(address: *const u8, length: usize);
+    fn net_socket(operation: u32, address: *const u8, length: usize) -> i32;
+    fn net_release(operation: u32, address: *mut u8, length: usize) -> i32;
+}
+
+pub(crate) fn open_url(url: &[u8]) {
+    // The host reads this slice synchronously and launches the configured browser.
+    unsafe { open_url_native(url.as_ptr(), url.len()) }
+}
+
+const CONNECT: u32 = 0;
+const READ: u32 = 1;
+const WRITE: u32 = 2;
+const CLOSE: u32 = 3;
+const WAKE: u32 = 4;
+const MAX_CHUNK: usize = 64 * 1024;
+
+struct ZoteroSocket;
+
+pub(crate) fn connect_zotero() -> Result<Box<dyn zotero::Socket>, String> {
+    // CONNECT and CLOSE do not read memory. CONNECT is limited to 127.0.0.1:23116.
+    match unsafe { net_socket(CONNECT, std::ptr::null(), 0) } {
+        0 => Ok(Box::new(ZoteroSocket)),
+        -3 => Err("OS/2 TCP/IP is unavailable. Install and start the OS/2 TCP/IP stack.".into()),
+        _ => Err("Could not connect to Zotero on 127.0.0.1:23116.".into()),
+    }
+}
+
+impl zotero::Socket for ZoteroSocket {
+    fn wake(&self) {
+        // WAKE only schedules a frame.
+        unsafe { net_socket(WAKE, std::ptr::null(), 0) };
+    }
+}
+
+impl Drop for ZoteroSocket {
+    fn drop(&mut self) {
+        unsafe { net_socket(CLOSE, std::ptr::null(), 0) };
+    }
+}
+
+fn result(code: i32) -> io::Result<usize> {
+    match code {
+        -2 => Err(io::ErrorKind::WouldBlock.into()),
+        n if n >= 0 => Ok(n as usize),
+        _ => Err(io::Error::other("The OS/2 TCP/IP socket failed or timed out")),
+    }
+}
+
+impl Read for ZoteroSocket {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        if buf.is_empty() {
+            return Ok(0);
+        }
+        // The host writes at most the requested length and retains no pointer.
+        result(unsafe { net_socket(READ, buf.as_mut_ptr(), buf.len().min(MAX_CHUNK)) })
+    }
+}
+
+impl Write for ZoteroSocket {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        if buf.is_empty() {
+            return Ok(0);
+        }
+        // The host reads only the requested length and retains no pointer.
+        result(unsafe { net_socket(WRITE, buf.as_ptr(), buf.len().min(MAX_CHUNK)) })
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+/// The host starts a child process and signals readiness from the PM timer.
+pub(crate) fn release_check(start: bool) -> Result<Option<String>, String> {
+    const START: u32 = 0;
+    const STATUS: u32 = 1;
+    const READ: u32 = 2;
+    const LIMIT: i32 = 2 * 1024 * 1024;
+    let operation = if start { START } else { STATUS };
+    // START and STATUS never access engine memory.
+    let status = unsafe { net_release(operation, std::ptr::null_mut(), 0) };
+    match status {
+        -2 => Ok(None),
+        -3 => Err("Install OS/2 curl with a trusted CA bundle, then place CURL.EXE on PATH or set WORDCRAFT_CURL.".into()),
+        length @ 1..=LIMIT if !start => {
+            let mut output = vec![0; length as usize];
+            // READ fills exactly the provided allocation and retains no pointer.
+            if unsafe { net_release(READ, output.as_mut_ptr(), output.len()) } != length {
+                return Err("Could not read the release metadata.".into());
+            }
+            String::from_utf8(output).map(Some).map_err(|_| "GitHub returned invalid UTF-8 release metadata.".into())
+        }
+        _ => Err("Could not check releases. Check OS/2 TCP/IP, system time and curl's CA bundle.".into()),
+    }
+}
diff --git a/apps/wordcraft-warp/src/print_bridge.rs b/apps/wordcraft-warp/src/print_bridge.rs
new file mode 100644
index 0000000..c768f1e
--- /dev/null
+++ b/apps/wordcraft-warp/src/print_bridge.rs
@@ -0,0 +1,132 @@
+//! Streaming bridge to Presentation Manager's configured printer queues.
+use wordcraft_engine::print::MAX_PRINT_PAGES;
+use wordcraft_ui_egui::printing::{Discover, Duplex, Printer, RasterJob, SubmitRaster};
+
+#[link(wasm_import_module = "wc_host")]
+unsafe extern "C" {
+    #[link_name = "print_queues"]
+    fn queues(output: *mut u8, capacity: usize) -> i32;
+    #[link_name = "print_start"]
+    fn start(name: *const u8, length: usize, orientation: u32, paper: u32, duplex: u32, gray: u32) -> i32;
+    #[link_name = "print_page"]
+    fn page(rgba: *const u8, width: u32, height: u32, width_millipoints: u32, height_millipoints: u32) -> i32;
+    #[link_name = "print_finish"]
+    fn finish(cancel: u32) -> i32;
+}
+
+fn printer_list() -> Option<Vec<Printer>> {
+    let mut buffer = vec![0; 65_535];
+    // The host writes at most the length of this live destination buffer.
+    let size = unsafe { queues(buffer.as_mut_ptr(), buffer.len()) };
+    let mut input = buffer.get(..usize::try_from(size).ok()?)?;
+    let mut printers = Vec::new();
+    while !input.is_empty() {
+        let [default, name_len, label_lo, label_hi] = <[u8; 4]>::try_from(input.get(..4)?).ok()?;
+        input = &input[4..];
+        let name_len = usize::from(name_len);
+        let label_len = usize::from(u16::from_le_bytes([label_lo, label_hi]));
+        let (name, tail) = input.split_at_checked(name_len)?;
+        let (label, tail) = tail.split_at_checked(label_len)?;
+        // Preserve the queue name byte for byte when it goes back to the spooler.
+        let decode = |bytes: &[u8]| bytes.iter().copied().map(char::from).collect();
+        printers.push(Printer { name: decode(name), label: decode(label), default: default != 0 });
+        input = tail;
+    }
+    Some(printers)
+}
+
+pub(crate) fn discover() -> Discover {
+    Box::new(|| {
+        let (sender, receiver) = std::sync::mpsc::channel();
+        if let Some(printers) = printer_list() {
+            let _ = sender.send(printers);
+        }
+        receiver
+    })
+}
+
+fn paper_number(paper: Option<&str>) -> u32 {
+    // Standard form numbers from the Warp Toolkit's dynamic job properties ABI.
+    match paper {
+        Some("Letter") => 1,
+        Some("Legal") => 2,
+        Some("Tabloid") => 8,
+        Some("Statement") => 10,
+        Some("Executive") => 11,
+        Some("A3") => 15,
+        Some("A4") => 16,
+        Some("A5") => 18,
+        Some("Envelope #10") => 27,
+        Some("Envelope DL") => 31,
+        Some("B4 (JIS)") => 75,
+        Some("B5 (JIS)") => 76,
+        _ => 0,
+    }
+}
+
+struct ActiveJob;
+
+impl Drop for ActiveJob {
+    fn drop(&mut self) {
+        // Any failure while preparing or drawing a page discards the unfinished native job.
+        unsafe { finish(1) };
+    }
+}
+
+pub(crate) fn submit() -> SubmitRaster {
+    Box::new(|job: RasterJob<'_>| {
+        let name: Vec<u8> = job.settings.printer.chars().map(|ch| ch as u8).collect();
+        let duplex = match job.settings.duplex {
+            None => 0,
+            Some(Duplex::Off) => 1,
+            Some(Duplex::LongEdge) => 2,
+            Some(Duplex::ShortEdge) => 3,
+        };
+        // The printer's name stays live for this call. Job state belongs to PM until finish.
+        let status = unsafe { start(name.as_ptr(), name.len(), if job.landscape { 2 } else { 1 }, paper_number(job.paper), duplex, u32::from(job.settings.grayscale)) };
+        let duplex = match status {
+            0 => false,
+            1 => true,
+            -2 => return Err("The selected OS/2 printer queue is unavailable.".into()),
+            -4 => return Err("The printer driver rejected the selected paper size.".into()),
+            -5 => return Err("The printer driver rejected the selected duplex mode.".into()),
+            _ => return Err("Presentation Manager could not start the print job.".into()),
+        };
+        let active = ActiveJob;
+        let separators = duplex && job.collate && job.chosen % 2 == 1;
+        let padding = if separators { job.settings.copies.saturating_sub(1) as usize } else { 0 };
+        if job.total + padding > MAX_PRINT_PAGES {
+            return Err("the selected pages and copies exceed the print-job page limit".into());
+        }
+        for (index, raster) in job.pages.enumerate() {
+            if separators && index != 0 && index % job.chosen == 0 {
+                // A blank reverse side keeps the next collated copy on a fresh sheet.
+                check_page(unsafe { page(std::ptr::null(), 0, 0, 0, 0) })?;
+            }
+            let raster = raster?;
+            let image = raster.image;
+            let width = (raster.points.0 * 1000.0).round() as u32;
+            let height = (raster.points.1 * 1000.0).round() as u32;
+            if image.pixels.len() != image.width as usize * image.height as usize * 4 {
+                return Err("WordCraft produced an invalid print bitmap.".into());
+            }
+            // The host consumes this bounded image synchronously and retains no engine pointers.
+            check_page(unsafe { page(image.pixels.as_ptr(), image.width, image.height, width, height) })?;
+        }
+        let result = unsafe { finish(0) };
+        std::mem::forget(active);
+        match result {
+            n if n > 0 => Ok(format!("OS/2 print queue job #{n}")),
+            0 => Ok("OS/2 print queue".into()),
+            _ => Err("Presentation Manager could not finish the print job.".into()),
+        }
+    })
+}
+
+fn check_page(result: i32) -> Result<(), String> {
+    match result {
+        0 => Ok(()),
+        -2 => Err("Printing cancelled.".into()),
+        _ => Err("Presentation Manager could not spool a document page.".into()),
+    }
+}
diff --git a/apps/wordcraft-warp/src/wasi.rs b/apps/wordcraft-warp/src/wasi.rs
new file mode 100644
index 0000000..c95f866
--- /dev/null
+++ b/apps/wordcraft-warp/src/wasi.rs
@@ -0,0 +1,398 @@
+use egui::epaint::{ClippedPrimitive, ImageData, Primitive};
+use egui::{Context, Event, Key, Modifiers, PointerButton, RawInput, Rect, TextureId};
+use std::cell::RefCell;
+use wordcraft_engine::Session;
+use wordcraft_ui_egui::WordApp;
+
+use crate::a11y::Accessibility;
+use crate::file_bridge::Files;
+
+const MAX_EVENTS: usize = 4096;
+const MAX_SIDE: i32 = 4096;
+const MAX_PACKET: usize = 32 << 20;
+const SCALE: f32 = 1.0;
+
+struct Bridge {
+    app: WordApp,
+    files: Files,
+    context: Context,
+    events: Vec<Event>,
+    buttons: i32,
+    modifiers: Modifiers,
+    focused: bool,
+    should_close: bool,
+    last_tick: Option<u32>,
+    elapsed_ms: u64,
+    repaint_delay_ms: u32,
+    draw: Vec<u8>,
+    accessibility: Accessibility,
+}
+
+thread_local! {
+    static APP: RefCell<Option<Bridge>> = const { RefCell::new(None) };
+}
+
+fn with_app<T>(f: impl FnOnce(&mut Bridge) -> T) -> Option<T> {
+    APP.with(|app| app.try_borrow_mut().ok()?.as_mut().map(f))
+}
+
+fn dimensions(w: i32, h: i32) -> Option<egui::Vec2> {
+    ((1..=MAX_SIDE).contains(&w) && (1..=MAX_SIDE).contains(&h)).then(|| egui::vec2(w as f32, h as f32))
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn wc_init(w: i32, h: i32) -> i32 {
+    if dimensions(w, h).is_none() {
+        return 1;
+    }
+    APP.with(|state| {
+        let Ok(mut state) = state.try_borrow_mut() else { return 1 };
+        if state.is_some() {
+            return 0;
+        }
+        let files = Files::default();
+        let mut session = Session::new(wordcraft_engine::sample::sample_document());
+        session.system_region = wordcraft_ui_egui::i18n::system_region();
+        let mut services = files.services();
+        crate::clipboard::install(&mut services);
+        let mut app = WordApp::new(session, services);
+        app.autosave = false;
+        let context = Context::default();
+        context.set_pixels_per_point(SCALE);
+        *state = Some(Bridge {
+            app,
+            files,
+            context,
+            events: Vec::new(),
+            buttons: 0,
+            modifiers: Modifiers::default(),
+            focused: true,
+            should_close: false,
+            last_tick: None,
+            elapsed_ms: 0,
+            repaint_delay_ms: u32::MAX,
+            draw: Vec::new(),
+            accessibility: Accessibility::default(),
+        });
+        0
+    })
+}
+
+fn modifiers(mask: i32) -> Modifiers {
+    let ctrl = mask & 2 != 0;
+    Modifiers { shift: mask & 1 != 0, ctrl, alt: mask & 4 != 0, command: ctrl, mac_cmd: false }
+}
+
+fn key(code: i32) -> Option<Key> {
+    let name = match code {
+        8 => "Backspace",
+        9 => "Tab",
+        13 => "Enter",
+        27 => "Escape",
+        127 => "Delete",
+        256 => "ArrowLeft",
+        257 => "ArrowRight",
+        258 => "ArrowUp",
+        259 => "ArrowDown",
+        260 => "Home",
+        261 => "End",
+        262 => "PageUp",
+        263 => "PageDown",
+        264 => "Insert",
+        288 => "F1",
+        289 => "F2",
+        290 => "F3",
+        291 => "F4",
+        292 => "F5",
+        293 => "F6",
+        294 => "F7",
+        295 => "F8",
+        296 => "F9",
+        297 => "F10",
+        298 => "F11",
+        299 => "F12",
+        32..=126 => {
+            let ascii = [(code as u8).to_ascii_uppercase()];
+            return Key::from_name(std::str::from_utf8(&ascii).ok()?);
+        }
+        _ => return None,
+    };
+    Key::from_name(name)
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn wc_event(kind: i32, a: i32, b: i32, c: i32, d: i32) -> i32 {
+    with_app(|state| {
+        if state.events.len() > MAX_EVENTS - 5 {
+            return 1;
+        }
+        let mods = modifiers(d);
+        if mods != state.modifiers {
+            state.events.push(Event::ModifiersChanged(mods));
+            state.modifiers = mods;
+        }
+        match kind {
+            1 => {
+                let scale = state.context.pixels_per_point();
+                let pos = egui::pos2(a as f32 / scale, b as f32 / scale);
+                state.events.push(Event::PointerMoved(pos));
+                for (mask, button) in [(1, PointerButton::Primary), (2, PointerButton::Secondary), (4, PointerButton::Middle)] {
+                    if (state.buttons ^ c) & mask != 0 {
+                        state.events.push(Event::PointerButton { pos, button, pressed: c & mask != 0, modifiers: mods });
+                    }
+                }
+                state.buttons = c & 7;
+            }
+            2 => {
+                if let Some(key) = key(a) {
+                    crate::clipboard::key_event(&mut state.events, key, b != 0, c != 0, mods);
+                }
+            }
+            3 => state.events.push(Event::MouseWheel {
+                unit: egui::MouseWheelUnit::Point,
+                delta: egui::vec2(a as f32, b as f32),
+                phase: egui::TouchPhase::Move,
+                source: egui::MouseWheelSource::Wheel,
+                modifiers: mods,
+            }),
+            crate::a11y::SET_ENABLED => state.accessibility.set_enabled(&state.context, a != 0),
+            crate::a11y::ACTIVATE => {
+                if let Some(event) = state.accessibility.action(a as u32, b as u32) {
+                    state.events.push(event);
+                }
+            }
+            4 => state.events.push(Event::PointerGone),
+            5 => {
+                state.focused = a != 0;
+                state.events.push(Event::WindowFocused(state.focused));
+            }
+            _ => return 1,
+        }
+        0
+    })
+    .unwrap_or(1)
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn wc_text(codepoint: u32) -> i32 {
+    let Some(ch) = char::from_u32(codepoint).filter(|ch| !ch.is_control()) else { return 1 };
+    with_app(|state| {
+        if state.events.len() >= MAX_EVENTS {
+            return 1;
+        }
+        state.events.push(Event::Text(ch.to_string()));
+        0
+    })
+    .unwrap_or(1)
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn wc_frame(w: i32, h: i32, time_ms: u32) -> i32 {
+    let Some(size) = dimensions(w, h) else { return 1 };
+    with_app(|state| {
+        let previous_scale = state.context.pixels_per_point();
+        let screen = Rect::from_min_size(egui::Pos2::ZERO, size / previous_scale);
+        if let Some(last_tick) = state.last_tick.replace(time_ms) {
+            state.elapsed_ms = state.elapsed_ms.saturating_add(u64::from(time_ms.wrapping_sub(last_tick)));
+        }
+        let mut input = RawInput {
+            screen_rect: Some(screen),
+            max_texture_side: Some(2048),
+            time: Some(state.elapsed_ms as f64 / 1000.0),
+            events: std::mem::take(&mut state.events),
+            focused: state.focused,
+            ..RawInput::default()
+        };
+        if let Some(root) = input.viewports.get_mut(&egui::ViewportId::ROOT) {
+            root.native_pixels_per_point = Some(SCALE);
+            root.inner_rect = Some(screen);
+            root.focused = Some(state.focused);
+        }
+        let ctx = &state.context;
+        let app = &mut state.app;
+        app.raw_input_hook(ctx, &mut input);
+        let mut logic = true;
+        let frame = ctx.run_ui(input, |ui| {
+            if std::mem::take(&mut logic) {
+                app.logic(ui.ctx());
+            }
+            app.ui(ui);
+        });
+        let scale = frame.pixels_per_point;
+        if let Some(update) = frame.platform_output.accesskit_update {
+            state.accessibility.capture(update, scale);
+        }
+        crate::clipboard::output(&frame.platform_output.commands);
+        if let Some(root) = frame.viewport_output.get(&egui::ViewportId::ROOT) {
+            state.should_close |= root.commands.iter().any(|command| matches!(command, egui::ViewportCommand::Close));
+        }
+        state.repaint_delay_ms = if scale != previous_scale {
+            0
+        } else {
+            frame.viewport_output.get(&egui::ViewportId::ROOT)
+                .and_then(|root| u32::try_from(root.repaint_delay.as_millis()).ok())
+                .unwrap_or(u32::MAX)
+        };
+        let primitives = ctx.tessellate(frame.shapes, frame.pixels_per_point);
+        let mut textures = frame.textures_delta;
+        let screen_pixels = Rect::from_min_size(egui::Pos2::ZERO, size);
+        let packed = pack_draw(&mut state.draw, &textures, &primitives, screen_pixels, scale);
+        // The PM host receives every delta in the draw packet and owns its application.
+        textures.clear();
+        if packed.is_some() {
+            0
+        } else {
+            eprintln!("WordCraft's frame exceeded the Presentation Manager bridge limits.");
+            1
+        }
+    })
+    .unwrap_or(1)
+}
+
+/// Delay until the next requested repaint. The native host also wakes for input.
+#[unsafe(no_mangle)]
+pub extern "C" fn wc_repaint_delay_ms() -> u32 {
+    with_app(|state| state.repaint_delay_ms).unwrap_or(u32::MAX)
+}
+
+/// Take one pending document, picture, font or other open request.
+#[unsafe(no_mangle)]
+pub extern "C" fn wc_open_requested() -> i32 {
+    with_app(|state| state.files.take_request()).unwrap_or(0)
+}
+
+/// Allocate linear memory for one incoming filename and its contents.
+#[unsafe(no_mangle)]
+pub extern "C" fn wc_reserve_input(len: usize) -> usize {
+    with_app(|state| state.files.reserve_input(len)).flatten().unwrap_or(0)
+}
+
+/// Deliver the UTF-8 name followed by raw file bytes to WordCraft's own import queue.
+#[unsafe(no_mangle)]
+pub extern "C" fn wc_accept_input(name_len: usize, data_len: usize) -> i32 {
+    with_app(|state| {
+        if state.files.accept_input(name_len, data_len).is_some() {
+            state.context.request_repaint();
+            0
+        } else {
+            1
+        }
+    })
+    .unwrap_or(1)
+}
+
+/// The native window requested a close. `0` lets the upstream save prompt run first.
+#[unsafe(no_mangle)]
+pub extern "C" fn wc_close_request() -> i32 {
+    with_app(|state| i32::from(state.app.close_requested())).unwrap_or(0)
+}
+
+/// Acknowledge an upstream viewport close after the user has answered the prompt.
+#[unsafe(no_mangle)]
+pub extern "C" fn wc_should_close() -> i32 {
+    with_app(|state| i32::from(std::mem::take(&mut state.should_close))).unwrap_or(0)
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn wc_draw_ptr() -> usize {
+    with_app(|state| state.draw.as_ptr() as usize).unwrap_or(0)
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn wc_draw_len() -> usize {
+    with_app(|state| state.draw.len()).unwrap_or(0)
+}
+
+/// The current native accessibility snapshot remains valid until the next frame.
+#[unsafe(no_mangle)]
+pub extern "C" fn wc_a11y_ptr() -> usize {
+    with_app(|state| state.accessibility.packet.as_ptr() as usize).unwrap_or(0)
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn wc_a11y_len() -> usize {
+    with_app(|state| state.accessibility.packet.len()).unwrap_or(0)
+}
+
+fn texture_number(id: TextureId) -> Option<u32> {
+    let (value, tag) = match id {
+        TextureId::Managed(n) => (n, 0),
+        TextureId::User(n) => (n, 0x8000_0000),
+    };
+    (value < 0x8000_0000).then(|| value as u32 | tag)
+}
+
+fn put_u32(out: &mut Vec<u8>, value: u32) {
+    out.extend_from_slice(&value.to_le_bytes());
+}
+fn put_f32(out: &mut Vec<u8>, value: f32) {
+    out.extend_from_slice(&value.to_le_bytes());
+}
+
+fn pack_draw(out: &mut Vec<u8>, textures: &egui::TexturesDelta, primitives: &[ClippedPrimitive], screen: Rect, scale: f32) -> Option<()> {
+    let pixels = |pos: egui::Pos2| (pos.to_vec2() * scale).to_pos2();
+    let meshes = || {
+        primitives.iter().filter_map(|item| {
+            let Primitive::Mesh(mesh) = &item.primitive else { return None };
+            let clip = Rect::from_min_max(pixels(item.clip_rect.min), pixels(item.clip_rect.max)).intersect(screen);
+            (clip.is_positive() && !mesh.indices.is_empty()).then_some((mesh, clip))
+        })
+    };
+    let updates = || textures.set.iter().flat_map(|(id, deltas)| deltas.iter().map(move |delta| (*id, delta)));
+    let mut bytes = 16usize.checked_add(textures.free.len().checked_mul(4)?)?;
+    let mut set_count = 0u32;
+    for (_, delta) in updates() {
+        set_count = set_count.checked_add(1)?;
+        let ImageData::Color(image) = &delta.image;
+        bytes = bytes.checked_add(20usize.checked_add(image.pixels.len().checked_mul(4)?)?)?;
+    }
+    let mut mesh_count = 0u32;
+    for (mesh, _) in meshes() {
+        bytes = bytes.checked_add(28)?.checked_add(mesh.vertices.len().checked_mul(20)?)?.checked_add(mesh.indices.len().checked_mul(4)?)?;
+        mesh_count = mesh_count.checked_add(1)?;
+    }
+    if bytes > MAX_PACKET {
+        return None;
+    }
+    out.clear();
+    out.try_reserve(bytes).ok()?;
+    out.extend_from_slice(b"WCG1");
+    put_u32(out, set_count);
+    put_u32(out, mesh_count);
+    put_u32(out, u32::try_from(textures.free.len()).ok()?);
+    for (id, delta) in updates() {
+        let ImageData::Color(image) = &delta.image;
+        put_u32(out, texture_number(id)?);
+        let [x, y] = delta.pos.unwrap_or([u32::MAX as usize; 2]);
+        put_u32(out, u32::try_from(x).ok()?);
+        put_u32(out, u32::try_from(y).ok()?);
+        for d in image.size {
+            put_u32(out, u32::try_from(d).ok()?);
+        }
+        for color in &image.pixels {
+            out.extend_from_slice(&color.to_array());
+        }
+    }
+    for (mesh, clip) in meshes() {
+        put_u32(out, texture_number(mesh.texture_id)?);
+        for value in [clip.min.x, clip.min.y, clip.max.x, clip.max.y] {
+            put_f32(out, value);
+        }
+        put_u32(out, u32::try_from(mesh.vertices.len()).ok()?);
+        put_u32(out, u32::try_from(mesh.indices.len()).ok()?);
+        for vertex in &mesh.vertices {
+            let pos = pixels(vertex.pos);
+            for value in [pos.x, pos.y, vertex.uv.x, vertex.uv.y] {
+                put_f32(out, value);
+            }
+            out.extend_from_slice(&vertex.color.to_array());
+        }
+        for index in &mesh.indices {
+            put_u32(out, *index);
+        }
+    }
+    for id in &textures.free {
+        put_u32(out, texture_number(*id)?);
+    }
+    Some(())
+}
