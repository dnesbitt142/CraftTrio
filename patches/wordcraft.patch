+//! Drive Zotero on an injected nonblocking socket without starting a Rust thread.
+use std::io::{self, Read, Write};
+use std::sync::mpsc::{self, Receiver, Sender};
+
+use serde_json::Value;
+use wordcraft_zotero::{Call, Command, Outcome, wire};
+
+use super::Pending;
+
+/// A nonblocking connection. The host wakes the UI once a blocked read or write can make progress.
+pub trait Socket: Read + Write {
+    /// Ask the host to wake a frame after a human answers an alert.
+    fn wake(&self) {}
+}
+
+#[cfg(test)]
+impl Socket for std::net::TcpStream {}
+
+pub(super) struct Transport {
+    socket: Box<dyn Socket>,
+    calls: Sender<Pending>,
+    done: Option<Sender<Result<Outcome, String>>>,
+    outcome: Outcome,
+    outgoing: Vec<u8>,
+    sent: usize,
+    header: [u8; 8],
+    header_len: usize,
+    payload: Vec<u8>,
+    payload_len: usize,
+    reply: Option<Receiver<Result<Value, String>>>,
+}
+
+impl Transport {
+    pub(super) fn new(
+        socket: Box<dyn Socket>,
+        command: Command,
+        calls: Sender<Pending>,
+        done: Sender<Result<Outcome, String>>,
+    ) -> Result<Self, String> {
+        let mut outgoing = Vec::new();
+        wire::write_frame(&mut outgoing, 0, &wire::command_payload(command.wire_name())).map_err(|e| e.to_string())?;
+        Ok(Self {
+            socket,
+            calls,
+            done: Some(done),
+            outcome: Outcome::default(),
+            outgoing,
+            sent: 0,
+            header: [0; 8],
+            header_len: 0,
+            payload: Vec::new(),
+            payload_len: 0,
+            reply: None,
+        })
+    }
+
+    pub(super) fn wake(&self) {
+        self.socket.wake();
+    }
+
+    /// A call is queued or the transport is blocked, finished, or failed.
+    pub(super) fn poll(&mut self) {
+        if self.done.is_none() {
+            return;
+        }
+        let result = self.advance();
+        if !matches!(result, Ok(false)) {
+            if let Some(done) = self.done.take() {
+                let _ = done.send(result.map(|_| std::mem::take(&mut self.outcome)));
+            }
+        }
+    }
+
+    fn advance(&mut self) -> Result<bool, String> {
+        loop {
+            let txid = u32::from_be_bytes([self.header[0], self.header[1], self.header[2], self.header[3]]);
+            if let Some(reply) = &self.reply {
+                let result = match reply.try_recv() {
+                    Ok(result) => result,
+                    Err(mpsc::TryRecvError::Empty) => return Ok(false),
+                    Err(mpsc::TryRecvError::Disconnected) => Err("WordCraft closed the document".into()),
+                };
+                self.reply = None;
+                self.queue_reply(txid, result)?;
+            }
+            while let Some(bytes) = self.outgoing.get(self.sent..).filter(|b| !b.is_empty()) {
+                match self.socket.write(bytes) {
+                    Ok(0) => return Err("Zotero closed before receiving the answer".into()),
+                    Ok(n) => self.sent += n,
+                    Err(e) if e.kind() == io::ErrorKind::WouldBlock => return Ok(false),
+                    Err(e) if e.kind() == io::ErrorKind::Interrupted => {}
+                    Err(e) => return Err(format!("Could not send to Zotero: {e}")),
+                }
+            }
+            if self.outcome.completed {
+                return Ok(true);
+            }
+            if self.header_len != self.header.len() {
+                match fill(self.socket.as_mut(), &mut self.header, &mut self.header_len)? {
+                    Fill::Blocked => return Ok(false),
+                    Fill::Closed if self.header_len == 0 => return Ok(true),
+                    Fill::Closed => return Err("Zotero closed inside a frame header".into()),
+                    Fill::Ready => {}
+                }
+                let size = u32::from_be_bytes([self.header[4], self.header[5], self.header[6], self.header[7]]) as usize;
+                if size > wire::MAX_FRAME {
+                    return Err("Zotero sent a frame larger than the protocol limit".into());
+                }
+                self.payload.clear();
+                self.payload.try_reserve(size).map_err(|_| "Not enough memory to receive a Zotero frame".to_string())?;
+                self.payload.resize(size, 0);
+                self.payload_len = 0;
+            }
+            match fill(self.socket.as_mut(), &mut self.payload, &mut self.payload_len)? {
+                Fill::Blocked => return Ok(false),
+                Fill::Closed => return Err("Zotero closed inside a frame payload".into()),
+                Fill::Ready => {}
+            }
+            let txid = u32::from_be_bytes([self.header[0], self.header[1], self.header[2], self.header[3]]);
+            if txid == 0 {
+                self.header_len = 0;
+                continue;
+            }
+            self.outcome.calls = self.outcome.calls.saturating_add(1);
+            let call = match Call::parse(&self.payload) {
+                Ok(call) => call,
+                Err(e) => {
+                    self.queue_reply(txid, Err(e))?;
+                    continue;
+                }
+            };
+            self.outcome.completed = call.method == "Document_complete";
+            let (sender, receiver) = mpsc::channel();
+            self.reply = Some(receiver);
+            self.calls.send(Pending { call, reply: sender }).map_err(|_| "WordCraft closed the document".to_string())?;
+            return Ok(false);
+        }
+    }
+
+    fn queue_reply(&mut self, txid: u32, result: Result<Value, String>) -> Result<(), String> {
+        if let Err(e) = &result {
+            self.outcome.errors.push(e.clone());
+        }
+        self.outgoing.clear();
+        self.sent = 0;
+        self.header_len = 0;
+        wire::write_frame(&mut self.outgoing, txid, &wire::encode_reply(&result)).map_err(|e| e.to_string())
+    }
+}
+
+enum Fill {
+    Ready,
+    Blocked,
+    Closed,
+}
+
+fn fill(socket: &mut dyn Socket, bytes: &mut [u8], received: &mut usize) -> Result<Fill, String> {
+    while let Some(remaining) = bytes.get_mut(*received..).filter(|b| !b.is_empty()) {
+        match socket.read(remaining) {
+            Ok(0) => return Ok(Fill::Closed),
+            Ok(n) => *received += n,
+            Err(e) if e.kind() == io::ErrorKind::WouldBlock => return Ok(Fill::Blocked),
+            Err(e) if e.kind() == io::ErrorKind::Interrupted => {}
+            Err(e) => return Err(format!("Could not receive from Zotero: {e}")),
+        }
+    }
+    Ok(Fill::Ready)
+}
