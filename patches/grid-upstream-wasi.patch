index 0000000..eee5a6a
--- /dev/null
+++ b/apps/gridcraft-warp/src/file_bridge.rs
@@ -0,0 +1,110 @@
+//! File selection and byte delivery for the Presentation Manager host.
+use gridcraft_ui_egui::{Inbox, Services};
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+
+const MAX_PATH_BYTES: usize = 1024;
+const MAX_INPUT_BYTES: usize = 16 << 20;
+
+#[link(wasm_import_module = "wc_host")]
+unsafe extern "C" {
+    #[link_name = "open_url_native"]
+    fn native_open_url(url: *const u8, url_len: usize);
+    #[link_name = "save"]
+    fn native_save(name: *const u8, name_len: usize, data: *const u8, data_len: usize, save_as: i32, path: *mut u8, path_cap: usize) -> i32;
+}
+
+pub(crate) fn open_url(url: &str) {
+    // The host reads the live UTF-8 URL for this synchronous call.
+    unsafe { native_open_url(url.as_ptr(), url.len()) };
+}
+
+fn save(name: &str, data: &[u8], save_as: bool) -> Result<Option<String>, String> {
+    let mut path = [0u8; MAX_PATH_BYTES];
+    // The strings and byte slices stay live for the synchronous host call. The host validates
+    // offsets in the module's linear memory and writes at most `path.len()` bytes to `path`.
+    let result = unsafe { native_save(name.as_ptr(), name.len(), data.as_ptr(), data.len(), i32::from(save_as), path.as_mut_ptr(), path.len()) };
+    match result {
+        -1 => Ok(None),
+        0 => Ok(Some(name.to_owned())),
+        n if n > 0 => {
+            let name = path.get(..n as usize).ok_or("The OS/2 path is too long")?;
+            let name = std::str::from_utf8(name).map_err(|_| "The OS/2 path is not valid UTF-8")?;
+            if name.contains('\0') {
+                return Err("The OS/2 path contains a zero byte".into());
+            }
+            Ok(Some(name.to_owned()))
+        }
+        _ => Err("OS/2 could not save the workbook".into()),
+    }
+}
+
+#[derive(Default)]
+pub(crate) struct Files {
+    request: Rc<Cell<i32>>,
+    inbox: Inbox,
+    picture: Rc<RefCell<Option<Inbox>>>,
+    input: Vec<u8>,
+}
+
+impl Files {
+    pub(crate) fn services(&self) -> Services {
+        let request = self.request.clone();
+        let picture_request = self.request.clone();
+        let picture = self.picture.clone();
+        Services {
+            open_async: Some(Box::new(move || request.set(1))),
+            pick_picture_async: Some(Box::new(move |inbox| {
+                picture.replace(Some(inbox));
+                picture_request.set(2);
+            })),
+            inbox: Some(self.inbox.clone()),
+            open_url: Some(Box::new(open_url)),
+            host_save: Some(Box::new(save)),
+            download: Some(Box::new(|name, bytes| {
+                if let Err(e) = save(name, bytes, true) {
+                    eprintln!("{e}");
+                }
+            })),
+            ..Services::default()
+        }
+    }
+
+    pub(crate) fn take_request(&self) -> i32 {
+        self.request.replace(0)
+    }
+
+    pub(crate) fn reserve_input(&mut self, len: usize) -> Option<usize> {
+        if len == 0 || len > MAX_INPUT_BYTES + MAX_PATH_BYTES {
+            return None;
+        }
+        self.input.clear();
+        self.input.try_reserve_exact(len).ok()?;
+        self.input.resize(len, 0);
+        Some(self.input.as_mut_ptr() as usize)
+    }
+
+    pub(crate) fn accept_input(&mut self, name_len: usize, data_len: usize) -> Option<()> {
+        let picture = self.picture.take();
+        if name_len == 0 && data_len == 0 {
+            self.input.clear();
+            return Some(());
+        }
+        if name_len == 0 || name_len > MAX_PATH_BYTES || data_len > MAX_INPUT_BYTES || name_len.checked_add(data_len)? != self.input.len() {
+            return None;
+        }
+        let mut inbox = picture.as_ref().unwrap_or(&self.inbox).lock().ok()?;
+        if !inbox.is_empty() {
+            return None;
+        }
+        let name = std::str::from_utf8(self.input.get(..name_len)?).ok()?;
+        if name.contains('\0') {
+            return None;
+        }
+        let name = name.to_owned();
+        self.input.copy_within(name_len.., 0);
+        self.input.truncate(data_len);
+        inbox.push((name, std::mem::take(&mut self.input)));
+        Some(())
+    }
+}
